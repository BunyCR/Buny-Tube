    <!-- Uygulamaya ağ yuvaları oluşturma ve özel ağ protokolleri kullanma izni verir. Tarayıcı ve diğer uygulamalar İnternet'e veri gönderilmesi için araç sağlarlar, bu nedenle bu izin, İnternet'e veri göndermek için gerekli değildir. -->
    <uses-permission
        android:name="android.permission.INTERNET" />
    <!-- Uygulamaya, telefonun uykuya geçmesini önleme izni verir. -->
    <uses-permission
        android:name="android.permission.WAKE_LOCK" />
    <!-- Uygulamaya, hangi ağların bulunduğu ve hangilerinin bağlı olduğu gibi ağ bağlantılarıyla ilgili bilgileri görüntüleme izni verir. -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Uygulamanın paylaşılan depolama alanınıza içerik yazmasına izin verir. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!-- Bu uygulama, uygulamaların üzerinde veya ekranın diğer kısımlarında görünebilir. Bu durum, normal uygulama kullanımını etkileyebilir ve diğer uygulamaların görünümünü değiştirebilir. -->
    <uses-permission
        android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Uygulamanın ön plan hizmetlerinden faydalanmasına izin verir. -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Uygulamanın bildirimleri göstermesine izin verir -->
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS" />
    <queries>
        <intent>
            <action
                android:name="android.intent.action.VIEW" />
            <data
                android:scheme="http" />
        </intent>
    </queries>
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
